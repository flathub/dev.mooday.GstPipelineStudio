{
  "app-id": "dev.mooday.GstPipelineStudio",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "gst-pipeline-studio",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=shm",
    "--device=all",
    "--share=ipc",
    "--share=network",
    "--env=G_MESSAGES_DEBUG=none"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.la",
    "*.a"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "gst-pipeline-studio",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.freedesktop.org/-/project/12908/uploads/b86bce7c42d892f8f4bbb2662e8297d9/gst-pipeline-studio-0.6.0.tar.xz",
          "sha256": "6cdc5ecdfea165e5c06601fd151c3fd5abf9f1abd663b2fe3117f00916360652"
        }
      ]
    }
  ]
}