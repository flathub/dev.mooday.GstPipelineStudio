{
  "app-id": "dev.mooday.GstPipelineStudio",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "gst-pipeline-studio",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=shm",
    "--device=all",
    "--share=ipc",
    "--share=network",
    "--env=G_MESSAGES_DEBUG=none"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.la",
    "*.a"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-Dgir=false",
        "-Dvapi=false",
        "-Dicu=false",
        "-Dapp=false",
        "-Ddocs=false",
        "-Dglade=false",
        "-D_systemd=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.1.tar.xz",
          "sha256": "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8",
          "x-checker-data": {
            "type": "gnome",
            "name": "vte",
            "stable-only": true
          }
        }
      ]
    },
    {
      "name": "gst-pipeline-studio",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.freedesktop.org/api/v4/projects/12908/packages/generic/gst-pipeline-studio/0.7.3/gst-pipeline-studio-0.7.3.tar.xz",
          "sha256": "60edf4883a8f032ea36b79d73bbb8a79ae5b77d5bdd6f263b0204178454728de",
          "x-checker-data": {
            "type": "json",
            "url": "https://gitlab.freedesktop.org/api/v4/projects/12908/releases/permalink/latest",
            "version-query": ".tag_name",
            "url-query": ".assets.links[] | select(.url | endswith(\"/gst-pipeline-studio-\" + $version + \".tar.xz\")) | .url",
            "is-main-source": true
          }
        }
      ]
    }
  ]
}